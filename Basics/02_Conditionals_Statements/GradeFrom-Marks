#include <iostream>
using namespace std;

int main() {
    int n ;
    cin >> n;
    
    if (n>= 80) {
        cout << "O" ;
    }
    else if (n >= 70 && n < 80) {
        cout << "A+" ;
    }
    else if (n >= 60 && n < 70) {
        cout << "A";
    }
    else if (n >= 50 && n < 60) {
        cout << "B+" ;
    }
    else if (n >= 45 && n < 50) {
        cout << "B";
    }
    else if (n >= 40 && n < 45) {
        cout << "P";
    }
    else {
        cout << "F";
    }
    return 0;
}
