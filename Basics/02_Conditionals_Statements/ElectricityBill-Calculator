#include <iostream>
using namespace std;

int main() {
    int units ;
    int bill;
    cin >> units;
    
    if ( units <= 100) {
        bill = units * 5 ;
        cout << bill;
    }
    else if (units <= 200) {
        bill = (100 * 5) + ((units - 100) * 7);
        cout << bill;
    }
    else {
        bill = (100 * 5) + (100 * 7) + ((units-200)*10) ;
        cout << bill;
    }
    return 0 ;
}
   
